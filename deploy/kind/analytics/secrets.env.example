# Copy to secrets.env (git-ignored) and change every value.
# The password appears twice (POSTGRES_PASSWORD and inside ANALYTICS_DATABASE_URL): keep them equal.
POSTGRES_PASSWORD=change-me-analytics-db-password
ANALYTICS_DATABASE_URL=postgresql+asyncpg://analytics:change-me-analytics-db-password@postgres-analytics:5432/kotoro_analytics

# Must be the same value as the Go API's JWT_SECRET; at least 32 characters (production mode).
ANALYTICS_JWT_SECRET=change-me-to-the-same-value-as-the-go-api-jwt-secret

# Development broker in rabbitmq-dev.yaml. Point to the shared RabbitMQ when it exists.
RABBITMQ_DEFAULT_USER=analytics
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
ANALYTICS_RABBITMQ_URL=amqp://analytics:change-me-rabbitmq-password@rabbitmq:5672/
