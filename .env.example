POSTGRES_DB=nome
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres


DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable


DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=500
DB_CONN_MAX_LIFETIME=50m
DB_CONN_MAX_IDLE_TIME=50m


GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://admin:admin@localhost:5432/admin_db
GOOSE_MIGRATION_DIR=./migrations

# Auth: signs the Go API tokens; analytics-api validates them with the same value.
# Local default below; use a long random value (>= 32 chars) anywhere else.
JWT_SECRET=kotoro-local-development-jwt-secret-0001

# RabbitMQ / Outbox Relay
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
OUTBOX_EXCHANGE=kotoro.domain-events

# Analytics read database (postgres-analytics)
ANALYTICS_POSTGRES_DB=kotoro_analytics
ANALYTICS_POSTGRES_USER=analytics
ANALYTICS_POSTGRES_PASSWORD=analytics

# Analytics API (FastAPI)
ANALYTICS_ENVIRONMENT=local
ANALYTICS_LOG_LEVEL=info
ANALYTICS_METRICS_TIMEZONE=America/Sao_Paulo
# Used when running the API outside Docker; inside Compose the host is postgres-analytics:5432
ANALYTICS_DATABASE_URL=postgresql+asyncpg://${ANALYTICS_POSTGRES_USER}:${ANALYTICS_POSTGRES_PASSWORD}@localhost:5433/${ANALYTICS_POSTGRES_DB}
# Consumer (outside Docker); inside Compose the host is rabbitmq:5672
ANALYTICS_RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672/
